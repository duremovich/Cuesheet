{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.sql-text.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.*.config.ts",
    "scripts",
    "e2e",
    // Pure, import-free: scripts/migrate-show.ts runs it under plain Node.
    "src/shared/show-transfer.ts",
    // Pure, import-free: e2e/helpers.ts makes record ids with the app's generator.
    "src/shared/ids.ts"
  ]
}
