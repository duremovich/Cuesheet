# Copy to .dev.vars (git-ignored). Read by `pnpm dev`, `pnpm preview` and the e2e server.
# On first request, if no users exist, this account is created as the admin.
ADMIN_EMAIL=admin@cuesheet.test
ADMIN_PASSWORD=change-me-please
# Email (invites, "you were added"): a Resend API key. Empty: no email, links are copied.
# Production: docs/deploy.md, "Email (optional)".
RESEND_API_KEY=
