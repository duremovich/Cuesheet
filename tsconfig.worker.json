{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/worker",
    "src/shared",
    "test/worker",
    // Pure client modules the worker tests drive against the real engine (delete-undo).
    "src/web/lib/show-state.ts",
    "src/web/features/shared/restore.ts",
    "src/web/features/attachments/selectors.ts"
  ]
}
